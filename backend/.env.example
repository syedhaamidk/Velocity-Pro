# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com

# ── Database (MySQL / MariaDB) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=sports_user
DB_PASSWORD=your_strong_password_here
DB_NAME=sports_dashboard

# ── Security ─────────────────────────────────────────────────
# Used to protect POST /api/sync — generate with: openssl rand -hex 32
SYNC_API_KEY=change_me_to_a_random_secret

# ── Sports APIs ──────────────────────────────────────────────

# NBA  → ESPN unofficial (no key needed, works automatically)
# NHL  → Official NHL Stats API (no key needed, works automatically)
# EPL  → ESPN unofficial (no key needed, works automatically)
# UCL  → ESPN unofficial (no key needed, works automatically)

# IPL / Cricket → CricAPI (FREE, 100 calls/day)
# Sign up at https://cricapi.com/register → copy your key below
CRICAPI_KEY=

# Football (optional — enhances EPL/UCL with richer stats)
# Sign up at https://www.football-data.org/client/register → free tier (10 req/min)
FOOTBALL_DATA_API_KEY=
